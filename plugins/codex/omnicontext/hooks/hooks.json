{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @aaryanbindage/omnicontext hook session-start",
            "statusMessage": "Loading OmniContext memory",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
