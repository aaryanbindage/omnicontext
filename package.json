{
  "name": "@aaryanbindage/omnicontext",
  "version": "0.4.0",
  "description": "Persistent, cross-device memory shared by every AI agent: Claude Code, Claude Desktop, OpenAI Codex, Cursor, Gemini CLI and any MCP client. Your profile, your projects, and resumable handoffs.",
  "type": "module",
  "bin": {
    "omnicontext": "dist/omnicontext.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "dist/omnicontext.mjs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "mcpb": "node scripts/pack-mcpb.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.aaryanbindage/omnicontext",
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-plugin",
    "claude-desktop",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "memory",
    "persistent-memory",
    "context",
    "ai-memory",
    "cross-device",
    "sync",
    "handoff",
    "llm",
    "codex",
    "openai-codex",
    "cursor",
    "gemini-cli",
    "agents"
  ],
  "author": "aaryanbindage (https://github.com/aaryanbindage)",
  "license": "MIT",
  "homepage": "https://aaryanbindage.github.io/omnicontext/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaryanbindage/omnicontext.git"
  },
  "bugs": {
    "url": "https://github.com/aaryanbindage/omnicontext/issues"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7",
    "esbuild": "^0.28.2"
  }
}
