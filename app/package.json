{
  "name": "omnicontext-desktop",
  "productName": "OmniContext",
  "version": "0.1.2",
  "description": "OmniContext desktop app — manage the persistent, cross-device memory every Claude session shares.",
  "homepage": "https://aaryanbindage.github.io/omnicontext/",
  "author": {
    "name": "aaryanbindage",
    "email": "aaryanbindage@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "node build.mjs",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "io.github.aaryanbindage.omnicontext",
    "productName": "OmniContext",
    "artifactName": "OmniContext-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "renderer/**", "build/tray.png", "package.json"],
    "extraResources": [{ "from": "../dist/omnicontext.mjs", "to": "omnicontext.mjs" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
      "artifactName": "OmniContext-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OmniContext-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }, { "target": "zip", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "OmniContext-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
      "category": "Utility",
      "maintainer": "aaryanbindage <aaryanbindage@users.noreply.github.com>",
      "artifactName": "OmniContext-${version}-Linux-${arch}.${ext}"
    }
  }
}
